# Build / tooling outputs
node_modules/
dist/
dist-*/
_fixcheck*/
_trash_*/
_tmp_*/
_to-delete/
coverage/
.turbo/
reports/*
!reports/.gitkeep
reports/**/*.json
reports/**/*.log
reports/**/*.err
*.tsbuildinfo

# Downloaded runtime binaries are NOT committed (架构 §2.7 / O-05).
# Text assets (manifest / schema / LICENSE / SUMS / README) ARE committed.
resources/.cache/
resources/runtime/win-x64/yt-dlp.exe
resources/runtime/win-x64/aria2c.exe
resources/runtime/win-x64/node.exe
resources/runtime/win-x64/ffmpeg/
resources/runtime/win-x64/ffmpeg.zip
resources/runtime/win-x64/node.zip
*.part
*.zip

# Local-only scratch
.DS_Store
Thumbs.db
*.log
# Recorded progress fixtures ARE test data, not scratch logs (D-157).
!tests/fixtures/*.log
!reports/.gitkeep
