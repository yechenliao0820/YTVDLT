  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "node scripts/run-tests.mjs all --coverage",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:contract": "node scripts/run-tests.mjs contract",
    "test:integration:offline": "node scripts/run-tests.mjs integration",
    "test:online": "vitest run --config vitest.online.config.ts",
    "check-runtime": "node --import tsx scripts/check-runtime.mjs",
    "fetch:runtime": "node scripts/fetch-runtime.mjs",
    "u3:verify": "node scripts/u3-verify.mjs",
    "layering": "node scripts/check-layering.mjs",
    "acceptance": "node scripts/acceptance.mjs --milestone M1",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "3.2.4",
    "electron": "45.2.2",
    "electron-builder": "^26.0.0",
    "electron-updater": "^6.8.0",
    "tsx": "^4.20.3",
    "turbo": "^2.5.4",
    "typescript": "~5.8.3",
    "vitest": "3.2.4"
  },
  "ytvdltPlannedDependencies": {
    "_note": "登记但 M1 不安装（架构 §7.1）；M2–M5 按里程碑启用，严禁在 M1 引入 UI 依赖",
    "vite": "^6.3.5",
    "zod": "^3.24.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mui/material": "^6.0.0",
    "@playwright/test": "^1.50.0",
    "electron-builder": "^26.0.0",
    "electron-updater": "^6.8.0"
  }
}
